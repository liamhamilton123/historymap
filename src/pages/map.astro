---
import Base from '~/layouts/Base.astro';
import HistoryMap from '~/components/map/HistoryMap';
---

<Base
  title="Interactive Historical World Map — Policarta"
  description="Pan, zoom and scrub through time on a vector world map showing the territorial extent of historical nations, empires and polities."
  fullBleed
>
  {/* MapLibre needs a real canvas and window, so this is the sole client-only island. */}
  <HistoryMap client:only="react" />

  <noscript>
    <div class="mx-auto my-[18vh] max-w-[34rem] px-6 font-sans leading-relaxed">
      <h1 class="font-serif font-medium">Policarta</h1>
      <p>The interactive map needs JavaScript.</p>
    </div>
  </noscript>
</Base>
