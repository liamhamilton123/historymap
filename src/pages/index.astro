---
import Base from '~/layouts/Base.astro';
---

<Base
  title="Policarta"
  description="Explore history through an interactive map."
>
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col justify-center px-6 py-20 sm:px-10">
    <p class="mb-5 text-sm font-medium tracking-[0.18em] text-accent uppercase">Policarta</p>
    <h1 class="max-w-3xl font-serif text-5xl leading-[1.02] tracking-tight sm:text-7xl">
      Explore the shape of history.
    </h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-dim">
      A quiet, interactive map for moving through the world and its long history.
    </p>
    <div class="mt-10">
      <a
        href="/map"
        class="inline-flex items-center rounded-lg bg-accent px-5 py-3 text-sm font-medium text-ocean-deep transition-colors hover:bg-[#f0ca84] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Open the map
        <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </main>
</Base>
