---
import Base from '~/layouts/Base.astro';
---

<Base
  title="Policarta"
  description="Explore history through an interactive map."
>
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col justify-center px-6 py-20 text-center sm:px-10">
    <h1 class="font-serif text-6xl leading-[1.02] tracking-tight sm:text-8xl">
      Policarta
    </h1>
    <p class="mx-auto mt-7 max-w-xl text-lg leading-relaxed text-ink-dim">
      Trace the rise and fall of nations across the world’s long history.
    </p>
    <div class="mt-10">
      <a
        href="/map"
        class="inline-flex items-center rounded-lg bg-accent px-5 py-3 text-sm font-medium text-ocean-deep transition-colors hover:bg-[#f0ca84] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Open the map
        <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </main>
</Base>
