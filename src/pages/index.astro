---
import Base from '~/layouts/Base.astro';
import HistoryMap from '~/components/map/HistoryMap';
---

<Base
  title="Atlas"
  description="An interactive map."
  fullBleed
>
  {/*
    client:only because MapLibre needs a real canvas and window — there is
    nothing meaningful to server-render here. Every other page on the site
    ships zero JavaScript; this is the one island that pays for itself.
  */}
  <HistoryMap client:only="react" />

  <noscript>
    <div class="noscript">
      <h1>Atlas</h1>
      <p>The interactive map needs JavaScript.</p>
    </div>
  </noscript>
</Base>

<style>
  .noscript {
    max-width: 34rem;
    margin: 18vh auto;
    padding: 0 1.5rem;
    font-family: var(--sans);
    line-height: 1.6;
  }
  .noscript h1 { font-family: var(--serif); font-weight: 500; }
</style>
