    { "from": "1854-06-30", "to": "1861-02-04", "parts": ["USA", "confederacy-east", "west-virginia", "louisiana-purchase", "confederacy-west", "florida", "mobile-district", "florida-parishes", "oregon-country", "mexican-cession", "texas", "gadsden-purchase"],
      "source": "The Gadsden Purchase completed the contiguous border." },
    { "from": "1861-02-04", "to": "1863-06-20", "parts": ["USA", "louisiana-purchase", "oregon-country", "mexican-cession", "gadsden-purchase"],
