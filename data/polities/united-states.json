    { "from": "1865-05-26", "to": null, "parts": ["USA", "confederacy-east", "west-virginia", "louisiana-purchase", "confederacy-west", "florida", "mobile-district", "florida-parishes", "oregon-country", "mexican-cession", "texas", "gadsden-purchase"],
