    { "from": "1848-02-02", "to": "1854-06-30", "parts": ["USA", "confederacy-east", "west-virginia", "louisiana-purchase", "confederacy-west", "florida", "mobile-district", "florida-parishes", "oregon-country", "mexican-cession", "texas"],
